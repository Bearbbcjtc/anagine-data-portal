    "index":{
      "introduction":{
        "heading":"Indiana Precision Oncology (IPO) Data Commons",
        "text":"The Indiana University Precision Health Initiative is developing the Indiana Precision Oncology (IPO) Common Data Model (CDM) to facilitate research using clinicogenomics data collected and generated at Indiana University Health and beyond. The IPO CDM is compatible with the National Cancer Institute’s Genomic Data Common (GDC). It supports rich clinical and pathological features, reflects contemporary clinical practices, and enables AI/ML-ready infrastructure for biomedical informatics research. This initiative paves the way for the development of Research Data Commons across hospitals.",
        "link":"/submission"
      },
      "buttons":[
        {
          "name": "Define Data Field",
          "icon": "data-field-define",
          "body": "The IPO Data Commons defines the data in a general way and follows the convention of Genomic Data Commons (GDC). Please study the IPO Data Dictionary before you start browsing.",
          "link": "/DD",
          "label": "Learn more"
        },
        {
          "name": "Explore Data",
          "icon": "data-explore",
          "body": "The Exploration Page allows filtering data for targeted visualization, which gives you insights and a clear overview under selected factors.",
          "link": "/explorer",
          "label": "Explore data"
        },
        {
          "name": "Access Data",
          "icon": "data-access",
          "body": "Use our selected tool to filter out the data you need.",
          "link": "/query",
          "label": "Query data"
        },
        {
          "name": "Submit Data",
          "icon": "data-submit",
          "body": "Submit Data based on the IPO Data Dictionary. Currently, only the IPO DCC is authorized to submit data.",
          "link": "/submission",
          "label": "Submit data"
        }
      ],
